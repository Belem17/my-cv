---
import white from '../assets/Group 2.svg';
import pink from '../assets/LWPOLYLINE(1).svg';
import blue from '../assets/LWPOLYLINE.svg';
import green from '../assets/ARC.svg';

const {title, colour,link}=Astro.props;

const iconMap = {
  white: white,
  pink: pink,
  blue: blue,
  green: green
};
const selectedIcon = iconMap[colour];
---
<a aria-label={title} class="button" href={link};>
      <img src={selectedIcon.src}  alt="" role="presentation" />
      <b> {title}</b>
</a>

<style>
  .button {
    background-color: #D6E6E5 ;
    color: #8DA91C;
    display: inline-flex;
    align-items: center;
    border:none;
    text-align: center;
    width:fit-content;
    gap:10px;
    margin:10px;
    text-decoration-line: none;
    
  }

  .button img {
    width: 50PX;
    height: auto;
  }
</style>